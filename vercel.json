{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node tools/build.mjs",
  "outputDirectory": "public",
  "functions": { "api/mare.mjs": { "includeFiles": "data/**", "maxDuration": 30 } },
  "rewrites": [{ "source": "/((?!api/).+)", "destination": "/api/mare?__p=/$1" }]
}
