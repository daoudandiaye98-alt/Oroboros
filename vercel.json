{
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/vorschau/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/mail/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/vendor/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Vary",
          "value": "Accept-Language, Cookie"
        }
      ]
    },
    {
      "source": "/buchen",
      "headers": [
        {
          "key": "Vary",
          "value": "Accept-Language, Cookie"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "accept-language",
          "value": "^(?!\\s*de)[a-zA-Z].*"
        }
      ],
      "missing": [
        {
          "type": "query",
          "key": "lang"
        },
        {
          "type": "cookie",
          "key": "lang",
          "value": "de"
        }
      ],
      "destination": "/en",
      "permanent": false
    },
    {
      "source": "/buchen",
      "has": [
        {
          "type": "header",
          "key": "accept-language",
          "value": "^(?!\\s*de)[a-zA-Z].*"
        }
      ],
      "missing": [
        {
          "type": "query",
          "key": "lang"
        },
        {
          "type": "cookie",
          "key": "lang",
          "value": "de"
        }
      ],
      "destination": "/en/book",
      "permanent": false
    },
    {
      "source": "/arbeiten",
      "destination": "/portfolio",
      "permanent": false
    },
    {
      "source": "/en/buchen",
      "destination": "/en/book",
      "permanent": false
    },
    {
      "source": "/en/portfolio",
      "destination": "/en#work",
      "permanent": false
    }
  ]
}
