{
  "name": "oroboros-werk",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --force",
    "pruefstand": "tsx pruefstand/lauf.ts",
    "beleg": "node pruefstand/beleg.mjs pruefstand/artefakte/belege",
    "selbsttest": "node pruefstand/selbsttest.mjs pruefstand/artefakte/selbsttest",
    "prolog": "node scripts/prolog-bauen.mjs",
    "sequenz": "node scripts/sequenz-bauen.mjs",
    "quellen": "bash scripts/pruefsummen.sh",
    "abnahme": "node pruefstand/abnahme-prolog.mjs",
    "aufnahmen": "node pruefstand/prolog-aufnahmen.mjs",
    "gesetz": "grep -rn 'cubic-bezier\\|duration:[[:space:]]*[0-9]' src/ --exclude-dir=styles || echo 'GESETZ GEHALTEN — 0 Treffer'"
  },
  "dependencies": {
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/jost": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "gsap": "^3.13.0",
    "lenis": "^1.3.11",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.18.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "ffmpeg-static": "^5.3.0",
    "playwright": "^1.56.0",
    "pngjs": "^7.0.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  }
}
